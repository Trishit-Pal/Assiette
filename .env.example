ENV=development
GROQ_API_KEY=
DATABASE_URL=sqlite:///./assiette.db
# Neon pooled URL for production (transaction mode):
# DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-in-production
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_STUDENT_DOMAINS=essec.edu,centralesupelec.fr,u-paris.fr,sorbonne-universite.fr
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
TRUSTED_PROXY_COUNT=1
FRESHNESS_WARN_DAYS=14
FRESHNESS_REFUSE_DAYS=30
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=assiette@localhost
RESEND_API_KEY=
AUTH_TOKEN_TTL_MINUTES=30
SESSION_TTL_DAYS=7
SERVE_FRONTEND=true
ASSIETTE_AUTO_INIT_DB=
REFRESH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP Redis URL for SlowAPI shared rate limits in production (Upstash Redis, not REST):
REDIS_URL=
